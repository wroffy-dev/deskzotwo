# Add these to deploy/azure/.env on the CRM VM for the split deployment (docs/deploy-split.md).

# This VM's private address in the VNet. The internal API listens on it, port 8443, and nowhere else.
CRM_PRIVATE_IP=10.0.1.4

# The internal API, for the admin app (docs/internal-api.md).
DESKZO_INTERNAL_API=on
# Exactly what the admin app calls this VM by: its CRM_INTERNAL_API_URL's host and port.
DESKZO_INTERNAL_API_HOST=10.0.1.4:8443
DESKZO_INTERNAL_API_KEY_ID=k1
# openssl rand -hex 32 — the same value goes into the admin app's CRM_INTERNAL_API_SECRET.
DESKZO_INTERNAL_API_SECRET=

# The old console on admin.<domain>: off once the admin app is in use. Ticks and payment webhooks still
# answer there on their secrets; nothing else does. Unset it to bring the old console back.
DESKZO_CONSOLE=off
# Where staff open the console now — links in alert mail, support mail and owners' notices.
PLATFORM_CONSOLE_ORIGIN=https://console.example.com
